# FoodRescue AI Environment Configuration Template
# Copy to .env and configure secret keys

# Gemini LLM Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Persistence Configuration (Production Supabase PostgreSQL)
FOODRESCUE_DATABASE=supabase
FOODRESCUE_DB_BACKEND=supabase

# Supabase PostgreSQL Configuration
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_KEY=your_supabase_publishable_key
# SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# SUPABASE_SECRET_KEY=your_supabase_secret_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Meta WhatsApp Cloud API Configuration (New Meta App: FoodRescueAI)
META_APP_ID=1591721079088296
META_BUSINESS_ID=1697813834850499
WHATSAPP_BUSINESS_ACCOUNT_ID=2279553849254105
WHATSAPP_PHONE_NUMBER_ID=1285744151285887
WHATSAPP_VERIFY_TOKEN=foodrescue_meta_verify_token
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# VALSEA AI Speech-to-Text Voice Intelligence
VALSEA_API_KEY=your_valsea_api_key_here

# GraphHopper Routing API Key (Real Road Distance, ETAs, Route Geometry)
GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here

# QRCoder API Key (V4 API: https://www.qrcoder.co.uk/api/v4/)
QRCODER_API_KEY=your_qrcoder_api_key_here

# FoodRescue MCP Server Configuration
MCP_SERVER_NAME=foodrescue-ai
MCP_TRANSPORT=stdio
